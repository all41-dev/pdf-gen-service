{
  "compilerOptions": {
    "types": ["node", "mocha"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2024",
    "module": "CommonJs",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./test/", "./node_modules/", "./dist/"],
  "ts-node": {
    "compilerOptions": {
      "lib": ["ES2025"],
      "module": "commonjs"
    }
  }
}
